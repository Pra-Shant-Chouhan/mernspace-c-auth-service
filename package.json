{
    "name": "auth-service",
    "version": "1.0.0",
    "description": "The User management service",
    "homepage": "https://github.com/Pra-Shant-Chouhan/mernspace-c-auth-service#readme",
    "bugs": {
        "url": "https://github.com/Pra-Shant-Chouhan/mernspace-c-auth-service/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Pra-Shant-Chouhan/mernspace-c-auth-service.git"
    },
    "license": "ISC",
    "author": "Prashant Chouhan",
    "type": "module",
    "main": "dist/server.js",
    "scripts": {
        "dev": "node --watch --env-file=.env src/server.ts",
        "build": "tsc",
        "start": "node dist/server.js",
        "format:fix": "prettier . --write",
        "format:check": "prettier . --check",
        "lint:check": "eslint .",
        "lint:fix": "eslint . --fix",
        "test": "jest --watch --runInBand",
        "prepare": "husky"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/express": "^5.0.6",
        "@types/http-errors": "^2.0.5",
        "@types/jest": "^30.0.0",
        "@types/node": "^26.6.6",
        "@types/supertest": "^7.2.1",
        "eslint": "^10.14.0",
        "husky": "^9.1.7",
        "jest": "^30.5.2",
        "lint-staged": "^17.6.0",
        "nodemon": "^3.1.14",
        "prettier": "3.9.10",
        "supertest": "^7.3.2",
        "ts-jest": "^29.4.15",
        "ts-node": "^10.9.2",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.72.1"
    },
    "lint-staged": {
        "*.ts": [
            "npm run format:fix",
            "npm run lint:fix"
        ]
    },
    "dependencies": {
        "express": "^5.3.0",
        "http-errors": "^2.0.1",
        "winston": "^3.19.0"
    }
}
